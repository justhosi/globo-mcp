{
  "name": "globo-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the GLOBO Portal (globohq.com) interpreter work portal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justhosi/globo-mcp.git"
  },
  "homepage": "https://github.com/justhosi/globo-mcp#readme",
  "bugs": {
    "url": "https://github.com/justhosi/globo-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "globo",
    "interpreter",
    "stdio"
  ],
  "type": "module",
  "bin": {
    "globo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
